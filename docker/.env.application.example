# Deployed into the self-hosted Convex backend. setup.sh generates the two
# application secrets below and keeps this file mode 0600.
SITE_URL=http://localhost:3000
ENV=development
BETTER_AUTH_SECRET=
TAHUNA_CREDENTIALS_SECRET=

# Required for login and object storage.
RESEND_API_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
TAHUNA_RUNTIME_IMAGE_REPO=ghcr.io/tahunalabs/tahuna-oss

# Compute provider: runpod (default) or aws. See docker/aws.md for AWS setup.
TAHUNA_COMPUTE_PROVIDER=runpod
TAHUNA_MANAGED_RUNPOD_API_KEY=

# Required when TAHUNA_COMPUTE_PROVIDER=aws. Credentials are backend-only.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Include the token for temporary credentials; leave empty for IAM access keys.
AWS_SESSION_TOKEN=
TAHUNA_AWS_DEPLOYMENT_ID=
TAHUNA_AWS_AMI_ID=
TAHUNA_AWS_SUBNET_ID=
TAHUNA_AWS_SECURITY_GROUP_IDS=
# JSON map of EC2 instance type to whole-instance USD/hour price.
TAHUNA_AWS_INSTANCE_PRICES=
# Regional gp3 baseline storage price, in USD/GiB-month.
TAHUNA_AWS_VOLUME_GB_MONTHLY_PRICE=
# true only for a public subnet with an internet gateway; otherwise provide NAT.
TAHUNA_AWS_PUBLIC_IP=false

# Self-hosted bookkeeping defaults. Credits are virtual; the operator still
# pays the configured compute provider. 1,000,000 cents = $10,000 per new user.
TAHUNA_INITIAL_CREDIT_CENTS=1000000
TAHUNA_COMPUTE_MARKUP_MULTIPLIER=1
TAHUNA_RUNTIME_REQUEST_TIMEOUT_SECONDS=120

# Optional social login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
HUGGINGFACE_CLIENT_ID=
HUGGINGFACE_CLIENT_SECRET=

# Optional paid credit top-ups. Not required with the initial grant above.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
