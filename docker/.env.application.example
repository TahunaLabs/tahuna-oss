# Deployed into the self-hosted Convex backend. setup.sh generates the two
# application secrets below and keeps this file mode 0600.
SITE_URL=http://localhost:3000
ENV=development
BETTER_AUTH_SECRET=
TAHUNA_CREDENTIALS_SECRET=

# Required for login, object storage, and RunPod compute.
RESEND_API_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
TAHUNA_MANAGED_RUNPOD_API_KEY=
TAHUNA_RUNTIME_IMAGE_REPO=ghcr.io/tahunalabs/tahuna

# Self-hosted bookkeeping defaults. Credits are virtual; the operator still
# pays the configured compute provider. 1,000,000 cents = $10,000 per new user.
TAHUNA_INITIAL_CREDIT_CENTS=1000000
TAHUNA_COMPUTE_MARKUP_MULTIPLIER=1
TAHUNA_RUNTIME_REQUEST_TIMEOUT_SECONDS=120

# Optional social login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
HUGGINGFACE_CLIENT_ID=
HUGGINGFACE_CLIENT_SECRET=

# Optional paid credit top-ups. Not required with the initial grant above.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
