# Local-only network binding. Use a reverse proxy with HTTPS before changing this.
TAHUNA_APP_BIND_ADDRESS=127.0.0.1
TAHUNA_CONVEX_BIND_ADDRESS=127.0.0.1
TAHUNA_DASHBOARD_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
CONVEX_PORT=3210
CONVEX_SITE_PORT=3211
DASHBOARD_PORT=6791

# Browser-visible URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=http://localhost:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://localhost:3211
NEXT_PUBLIC_DEPLOYMENT_URL=http://localhost:3210

# Static Tahuna artwork. Mirror this bucket and replace the URL for a fully
# independent deployment.
NEXT_PUBLIC_ASSETS_URL=https://pub-5f7c225fd68446a9b652150d7c7e52e9.r2.dev

# Backend origins embedded in generated URLs. For local evaluation, keep these
# on loopback. Remote compute requires CONVEX_SITE_ORIGIN to be public HTTPS.
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211

# Pinned, multi-architecture upstream images. Update both together.
CONVEX_BACKEND_IMAGE=ghcr.io/get-convex/convex-backend:2cbcf8179207eb4521360e6d81ebee5e7abbfa07@sha256:3d98531bef47a029b034055866e7873b1b4716a352a1f2eb9155183146f38793
CONVEX_DASHBOARD_IMAGE=ghcr.io/get-convex/convex-dashboard:2cbcf8179207eb4521360e6d81ebee5e7abbfa07@sha256:54016b75de1411f5be01e2f8a03a8f539f67ebfd51583e87122a20781c1a20a4

# Convex backend hardening and operational defaults.
DISABLE_BEACON=true
DISABLE_METRICS_ENDPOINT=true
DOCUMENT_RETENTION_DELAY=172800
# Leave empty when TLS terminates at a trusted reverse proxy.
DO_NOT_REQUIRE_SSL=true
REDACT_LOGS_TO_CLIENT=true
RUST_LOG=info
NEXT_PUBLIC_LOAD_MONACO_INTERNALLY=
