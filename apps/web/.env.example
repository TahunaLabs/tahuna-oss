# Web -> backend proxy target
BACKEND_URL=http://127.0.0.1:8000

# Optional: exposed to browser for CLI snippets/defaults
VITE_PUBLIC_TAHUNA_API_URL=http://localhost:8000

# JWT issuance for browser auth cookie
JWT_SECRET=replace-with-a-strong-shared-secret
JWT_ISSUER=tahuna-web
JWT_AUDIENCE=tahuna-api
JWT_TTL_SECONDS=604800
AUTH_COOKIE_NAME=tahuna_auth_token
AUTH_COOKIE_SECURE=false
