# Core infra
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tahuna?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# API
PORT=8000
AUTH_REQUIRED=true
DEV_USER_ID=
BOOTSTRAP_SECRET=change-me

# Sessions
SESSION_COOKIE_NAME=tahuna_session
SESSION_TTL=168h
COOKIE_SECURE=false

# Queue
TAHUNA_QUEUE_NAME=runs

# RunPod
RUNPOD_API_KEY=xxx

# R2 Storage
R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
R2_ACCESS_KEY=xxx
R2_SECRET_KEY=xxx
R2_BUCKET=tahuna

# Docker Hub
DOCKER_USER=pazuzzu
