# Core infra
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tahuna?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# API
PORT=8000
AUTH_REQUIRED=true
DEV_USER_ID=

# Sessions
SESSION_COOKIE_NAME=tahuna_session
SESSION_TTL=168h
COOKIE_SECURE=false

# Queue
TAHUNA_QUEUE_NAME=runs

# Docker Hub
DOCKER_USER=pazuzzu

# Optional: signup email via Resend
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=onboarding@resend.dev
