# Core infra
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tahuna?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# API
PORT=8000
AUTH_REQUIRED=true
DEV_USER_ID=

# JWT validation for browser-issued auth tokens
JWT_SECRET=replace-with-a-strong-shared-secret
JWT_ISSUER=tahuna-web
JWT_AUDIENCE=tahuna-api
EMAIL_OTP_TTL=10m

# Queue
TAHUNA_QUEUE_NAME=runs

# Docker Hub
DOCKER_USER=pazuzzu

# Optional: auth email delivery via Resend
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# RunPod
RUNPOD_API_KEY=
