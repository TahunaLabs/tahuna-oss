# Convex deployment URL (e.g. https://nice-fox-123.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=
# Convex site URL (e.g. https://nice-fox-123.convex.site)
NEXT_PUBLIC_CONVEX_SITE_URL=
# Canonical public backend URL (preferred alias for NEXT_PUBLIC_CONVEX_SITE_URL)
NEXT_PUBLIC_TAHUNA_SITE_URL=
# Public app URL for Better Auth baseURL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side app URL for Better Auth baseURL
SITE_URL=http://localhost:3000

# Optional: exposed to browser for CLI snippets/defaults
NEXT_PUBLIC_TAHUNA_API_URL=http://localhost:3000

# Resend OTP delivery via Convex Resend component (required)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Runpod provisioning (required for real GPU pod allocation)
RUNPOD_API_KEY=
# Optional: SECURE (default) or COMMUNITY
RUNPOD_CLOUD_TYPE=SECURE
