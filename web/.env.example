# Backend deployment URL (e.g. https://nice-fox-123.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=
# Backend HTTP actions URL (e.g. https://nice-fox-123.convex.site)
NEXT_PUBLIC_CONVEX_SITE_URL=
# Public app URL for Better Auth baseURL (e.g. http://localhost:3000)
NEXT_PUBLIC_SITE_URL=
# Stripe server-side secret key for prepaid credits checkout
STRIPE_SECRET_KEY=
# Stripe webhook signing secret for /stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Tahuna-owned provider credential for managed compute billing
TAHUNA_MANAGED_RUNPOD_API_KEY=
