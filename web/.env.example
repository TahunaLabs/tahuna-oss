# Backend deployment URL (e.g. https://nice-fox-123.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=
# Backend HTTP actions URL (e.g. https://nice-fox-123.convex.site)
NEXT_PUBLIC_CONVEX_SITE_URL=
# Public app URL for Better Auth baseURL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side app URL for Better Auth baseURL
SITE_URL=http://localhost:3000


# Resend OTP delivery via Convex Resend component (required)
RESEND_API_KEY=
# Optional: explicit sender used for production deployments (defaults to hi@tahuna.app)
TAHUNA_OTP_FROM_EMAIL_PRODUCTION=hi@tahuna.app
# Optional: explicit sender used for non-production deployments (defaults to onboarding@resend.dev)
TAHUNA_OTP_FROM_EMAIL_NON_PRODUCTION=onboarding@resend.dev

# Server-side master key for encrypted per-user Runpod credentials (base64-encoded 32 bytes)
TAHUNA_RUNPOD_CREDENTIALS_KEY=
# Optional: SECURE (default) or COMMUNITY
RUNPOD_CLOUD_TYPE=SECURE
# Optional: managed runtime image repository used for framework/version mapping
TAHUNA_RUNTIME_IMAGE_REPO=docker.io/pazuzzu/tahuna
# Optional: in-pod runtime API timeout in seconds
TAHUNA_RUNTIME_REQUEST_TIMEOUT_SECONDS=120

# Documentation URL (exposed to browser)
NEXT_PUBLIC_DOCS_URL=https://docs.tahuna.app
