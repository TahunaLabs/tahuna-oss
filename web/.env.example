# Convex deployment (e.g. dev:fucking-kangaroo-666)
CONVEX_DEPLOYMENT=
# Backend deployment URL (e.g. https://fucking-kangaroo-666.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=
# Backend HTTP actions URL (e.g. https://fucking-kangaroo-666.convex.site)
NEXT_PUBLIC_CONVEX_SITE_URL=
# Public app URL, browser-accessible (e.g. http://localhost:3000)
NEXT_PUBLIC_SITE_URL=
# PostHog analytics (https://us.posthog.com/project/<id>/settings)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://k.tahuna.app
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
