# Public app URL (e.g. http://localhost:3000 for dev, https://tahuna.app for prod)
# In dev (ENV=development), machine runtime callbacks use CONVEX_SITE_URL (Convex built-in) instead — localhost is safe
SITE_URL=
# GitHub OAuth app credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# HuggingFace OAuth app credentials
HUGGINGFACE_CLIENT_ID=
HUGGINGFACE_CLIENT_SECRET=
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# RunPod managed compute
TAHUNA_MANAGED_RUNPOD_API_KEY=
# Runtime image repo (e.g. ghcr.io/tahunalabs/tahuna)
# Prod/staging: injected at deploy by deploy-backend.yml via `convex env set`
# from the TAHUNA_RUNTIME_IMAGE_REPO GitHub Actions variable. Set locally only for dev.
TAHUNA_RUNTIME_IMAGE_REPO=
# Runtime request timeout in seconds
TAHUNA_RUNTIME_REQUEST_TIMEOUT_SECONDS=
# Better Auth secret
BETTER_AUTH_SECRET=
# Tahuna credentials secret
TAHUNA_CREDENTIALS_SECRET=
# Resend API key for transactional emails
RESEND_API_KEY=
# R2 storage
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_TOKEN=
ENV= # development | staging | production
