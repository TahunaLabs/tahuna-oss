# Public app URL (e.g. http://localhost:3000 for dev, https://tahuna.example.com for prod)
# In dev (ENV=development), machine runtime callbacks use CONVEX_SITE_URL (Convex built-in) instead — localhost is safe
SITE_URL=
# GitHub OAuth app credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# HuggingFace OAuth app credentials
HUGGINGFACE_CLIENT_ID=
HUGGINGFACE_CLIENT_SECRET=
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Compute provider: runpod (default) or aws. See docker/aws.md.
TAHUNA_COMPUTE_PROVIDER=runpod
# RunPod managed compute
TAHUNA_MANAGED_RUNPOD_API_KEY=
# AWS EC2 managed compute (backend-only credentials)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
TAHUNA_AWS_DEPLOYMENT_ID=
TAHUNA_AWS_AMI_ID=
TAHUNA_AWS_SUBNET_ID=
TAHUNA_AWS_SECURITY_GROUP_IDS=
TAHUNA_AWS_INSTANCE_PRICES=
TAHUNA_AWS_VOLUME_GB_MONTHLY_PRICE=
TAHUNA_AWS_PUBLIC_IP=false
# Runtime image repo (e.g. ghcr.io/tahunalabs/tahuna-oss)
# Prod/staging: injected at deploy by deploy-backend.yml via `convex env set`
# from the TAHUNA_RUNTIME_IMAGE_REPO GitHub Actions variable. Set locally only for dev.
TAHUNA_RUNTIME_IMAGE_REPO=
# Runtime request timeout in seconds
TAHUNA_RUNTIME_REQUEST_TIMEOUT_SECONDS=
# Better Auth secret
BETTER_AUTH_SECRET=
# Tahuna credentials secret
TAHUNA_CREDENTIALS_SECRET=
# Resend API key for transactional emails
RESEND_API_KEY=
# R2 storage
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ENV= # development | staging | production
